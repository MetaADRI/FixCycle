# Fixcycle PWA public environment
# Copy to .env and fill in. All keys are exposed to the browser (NEXT_PUBLIC_*).

# App role: user | driver | store
NEXT_PUBLIC_APP_ROLE=user

# Merchant API base (the existing Laravel backend), no trailing slash.
# Local override example for Phase 1 dev:
# NEXT_PUBLIC_API_BASE=http://localhost:8080
NEXT_PUBLIC_API_BASE=

# Merchant credentials (public/secret pair from the backend merchant settings).
# The PWA sends these as the publicKey / secretKey headers on every request.
NEXT_PUBLIC_MERCHANT_PUBLIC_KEY=
NEXT_PUBLIC_MERCHANT_SECRET_KEY=

# Default UI language. English is bundled as the fallback in Phase 1.
NEXT_PUBLIC_LOCALE=en

# OneSignal web push app id (wired in a later phase).
NEXT_PUBLIC_ONESIGNAL_APP_ID=

# Google Maps / Places key (used from the map picker phase onwards).
NEXT_PUBLIC_GOOGLE_MAPS_KEY=