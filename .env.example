# =============================================================================
# Fixcycle - Laravel backend environment template
# Copy to .env for local development. Never commit .env (contains secrets).
# Phase 1 adds PostgreSQL + PWA keys. Native Android apps keep working through
# the CORS_ALLOW_ALL=true fallback.
# =============================================================================

APP_NAME=MultiService
APP_ENV=local
# APP_ENV=production
APP_KEY=
APP_DEBUG=true
# APP_DEBUG=false
APP_URL=http://localhost

# Base path this app is served from (empty when served at domain root)
MICRO_SERVICE_APP_URL=/
MICRO_SERVICE_APP_FULL_URL=

LOG_CHANNEL=daily
QUEUE_CONNECTION=database

# --- Database ----------------------------------------------------------------
# Phase 1 target: PostgreSQL. Keep the mysql connection block for the old
# default until the dump/transform/restore (scripts/mysql-to-pgsql.md) is done.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=fixcycle
DB_USERNAME=
DB_PASSWORD=
DB_SOCKET=

# --- Cache / queue -----------------------------------------------------------
CACHE_DRIVER=file
BROADCAST_DRIVER=log
QUEUE_DRIVER=database
QUEUE_FAILED_DRIVER=database
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_FOR_CONFIG=false

# --- Session -----------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

# --- Mail --------------------------------------------------------------------
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

MAILGUN_DOMAIN=
MAILGUN_SECRET=

SES_KEY=
SES_SECRET=
SES_REGION=us-east-1

SPARKPOST_SECRET=

# --- AWS S3 ------------------------------------------------------------------
# Per-merchant S3 is injected by ApiS3Middleware / setS3Config; these are the
# fallback repository-level values.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=

# --- Filesystem --------------------------------------------------------------
FILESYSTEM_DRIVER=local
FILESYSTEM_CLOUD=s3

# --- Pusher / websockets (optional) -----------------------------------------
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

# --- Stripe (native apps only; not used by the PWA before Phase 16) ---------
STRIPE_KEY=
STRIPE_SECRET=

# --- Password hashing --------------------------------------------------------
BCRYPT_ROUNDS=10

# --- Mailgun / slack / memcached / sqs --------------------------------------
LOG_SLACK_WEBHOOK_URL=
MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211
MEMCACHED_USERNAME=
MEMCACHED_PASSWORD=
MEMCACHED_PERSISTENT_ID=
SQS_KEY=
SQS_SECRET=
SQS_PREFIX=https://sqs.us-east-1.amazonaws.com/your-account
SQS_QUEUE=your-queue-name
SQS_REGION=us-east-1

# --- wkhtmltopdf (invoices/receipts) ----------------------------------------
WKHTML_IMG_BINARY=
WKHTML_PDF_BINARY=/usr/local/bin/wkhtmltopdf

# --- Debugbar ----------------------------------------------------------------
DEBUGBAR_ENABLED=true
DEBUGBAR_THEME=auto
DEBUGBAR_EDITOR=vscode
DEBUGBAR_REMOTE_SITES_PATH=
DEBUGBAR_LOCAL_SITES_PATH=

# --- Telescope ---------------------------------------------------------------
TELESCOPE_ENABLED=true
TELESCOPE_DRIVER=file
TELESCOPE_PATH=telescope
TELESCOPE_DOMAIN=null
TELESCOPE_BATCH_WATCHER=true
TELESCOPE_CACHE_WATCHER=true
TELESCOPE_CLIENT_REQUEST_WATCHER=true
TELESCOPE_COMMAND_WATCHER=true
TELESCOPE_DUMP_WATCHER=true
TELESCOPE_DUMP_WATCHER_ALWAYS=true
TELESCOPE_EVENT_WATCHER=true
TELESCOPE_EXCEPTION_WATCHER=true
TELESCOPE_GATE_WATCHER=true
TELESCOPE_JOB_WATCHER=true
TELESCOPE_LOG_WATCHER=true
TELESCOPE_MAIL_WATCHER=true
TELESCOPE_MODEL_WATCHER=true
TELESCOPE_NOTIFICATION_WATCHER=true
TELESCOPE_QUERY_WATCHER=true
TELESCOPE_REDIS_WATCHER=true
TELESCOPE_REQUEST_WATCHER=true
TELESCOPE_RESPONSE_SIZE_LIMIT=null
TELESCOPE_SCHEDULE_WATCHER=true
TELESCOPE_VIEW_WATCHER=true

# --- Phase 1: PWA / CORS --------------------------------------------------------
# PWA frontend origin. When CORS_ALLOW_ALL=false, only this origin is allowed
# by the Access-Control-Allow-Origin header. Native apps keep the * fallback.
PWA_ORIGIN=https://app.example.com
CORS_ALLOW_ALL=true
# Comma-separated when CORS_ALLOW_ALL=false. Ignored while CORS_ALLOW_ALL=true.
CORS_ALLOWED_ORIGINS=https://app.example.com

# --- Phase 1: Map + push (unused until their phases) -------------------------
GOOGLE_MAPS_KEY=
ONESIGNAL_APP_ID=
ONESIGNAL_REST_KEY=